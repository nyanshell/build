-		suspend-seq = /bits/ 8 <0x2b 0x00>;
-		resume-seq = /bits/ 8 <0x2b 0x01>;
-	};
-
-	panel {
-		compatible = "clockwork,cpi3-lcd";
+		power-supply = <&reg_dcdc1>;
+		backlight = <&backlight>;
+		reset-gpios = <&pio 1 2 GPIO_ACTIVE_LOW>; /* PB2 */
+		cs-gpios = <&pio 2 3 GPIO_ACTIVE_LOW>; /* PC3 */
+		sck-gpios = <&pio 2 2 GPIO_ACTIVE_HIGH>; /* PC2 */
+		sda-gpios = <&pio 2 0 GPIO_ACTIVE_HIGH>; /* PC0 */
 
 		ports {
 			#address-cells = <1>;
@@ -151,6 +148,8 @@
 };
 
 &tcon0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&lcd_rgb666_pins>;
 	status = "okay";
 };
 
@@ -213,6 +212,14 @@
 };
 
 &r_pio {
+	/* Keep AP_WAKE_BT asserted, as in the vendor's unblocked state. */
+	bt-wake-hog {
+		gpio-hog;
+		gpios = <0 10 GPIO_ACTIVE_LOW>;
+		output-high;
+		line-name = "AP_WAKE_BT";
+	};
+
 	usb1_vbus_pin: usb1_vbus_pin@0 {
 		pins = "PL2";
 		function = "gpio_out";
@@ -235,7 +242,7 @@
 	};
 
 	bt_control_pin: bt_control_pin@0 {
-		pins = "PL8", "PL10";
+		pins = "PL8";
 		function = "gpio_out";
 	};
 };
