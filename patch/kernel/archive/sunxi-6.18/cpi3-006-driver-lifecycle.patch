+static void kd027_write(struct kd027_lcd *lcd, u8 command, u8 data)
+{
+	/* The DT describes chip select as active low. */
+	gpiod_set_value_cansleep(lcd->cs, 1);
+	udelay(1);
+	kd027_write_byte(lcd, command);
+	kd027_write_byte(lcd, data);
+	gpiod_set_value_cansleep(lcd->cs, 0);
+	udelay(1);
+}
+
+static int kd027_prepare(struct drm_panel *panel)
+{
+	struct kd027_lcd *lcd = to_kd027(panel);
+	int ret;
+
+	ret = regulator_enable(lcd->supply);
+	if (ret)
+		return ret;
+
+	gpiod_set_value_cansleep(lcd->reset, 1);
+	msleep(20);
+	gpiod_set_value_cansleep(lcd->reset, 0);
+	msleep(120);
+
+	/* Preserve the vendor's initialization sequence. */
+	kd027_write(lcd, 0x2b, 0x01);
+	kd027_write(lcd, 0x00, 0x07);
+	kd027_write(lcd, 0x0c, 0x27);
+	kd027_write(lcd, 0x16, 0x04);
+	msleep(20);
+
+	return 0;
+}
+
+static int kd027_enable(struct drm_panel *panel)
+{
+	/* DRM enables the linked backlight after this callback. */
+	kd027_write(to_kd027(panel), 0x2b, 0x01);
+	msleep(20);
+	return 0;
+}
+
+static int kd027_disable(struct drm_panel *panel)
+{
+	/* DRM has already disabled the linked backlight. */
+	kd027_write(to_kd027(panel), 0x2b, 0x00);
+	msleep(20);
+	return 0;
+}
+
+static int kd027_unprepare(struct drm_panel *panel)
+{
+	struct kd027_lcd *lcd = to_kd027(panel);
+
+	gpiod_set_value_cansleep(lcd->reset, 1);
+	return regulator_disable(lcd->supply);
+}
